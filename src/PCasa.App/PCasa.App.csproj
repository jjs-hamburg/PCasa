<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon Condition="Exists('Assets/PCasa.ico')">Assets/PCasa.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- One source of truth for the installed PCasa release identity.
         Windows requires numeric four-part versions; the visible product
         version follows the agreed Hauptversion.Subversion.Status.Build
         convention. The Git commit remains separately in BUILD-INFO. -->
    <Version>0.1.0-alpha.7</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.7</FileVersion>
    <InformationalVersion>0.1.Alpha.7</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="CefSharp.Wpf.NETCore" />
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native.win-x64" />
  </ItemGroup>
  
  <ItemGroup Condition="Exists('Assets/PCasa.ico')">
    <Resource Include="Assets/PCasa.ico" />
  </ItemGroup>
  <!-- Single embedded translation catalog; no external deployment dependency. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/gps-map.html" LogicalName="PCasa.App.Resources.gps-map.html" />
    <!-- CI provides the pinned, redistributable BSD-3 MapLibre assets.
         A developer build without them still uses the existing CDN fallback. -->
    <EmbeddedResource Include="Resources/maplibre-gl.js"
                      LogicalName="PCasa.App.Resources.maplibre-gl.js"
                      Condition="Exists('Resources/maplibre-gl.js')" />
    <EmbeddedResource Include="Resources/maplibre-gl.css"
                      LogicalName="PCasa.App.Resources.maplibre-gl.css"
                      Condition="Exists('Resources/maplibre-gl.css')" />
    <EmbeddedResource Include="Resources/english.json"
                      LogicalName="PCasa.App.Resources.english.json" />
    <!-- PCasa copyright/license and distribution notice are packaged with both Setup and ZIP. -->
    <Content Include="../../LICENSE" Link="Licenses/PCasa-GPL-3.0.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-APACHE-2.0.txt" Link="Licenses/Apache-2.0.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-MIT-Microsoft.txt" Link="Licenses/MIT-Microsoft.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-MIT-NetVips.txt" Link="Licenses/MIT-NetVips.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-LGPL-3.0.txt" Link="Licenses/LGPL-3.0.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="Licenses/THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Redistributed MapLibre BSD-3 and third-party attributions. -->
    <Content Include="Resources/maplibre-LICENSE.txt"
             Link="Licenses/MapLibre-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- User-editable JPG texture directory beside the published EXE. -->
  <ItemGroup>
    <Content Include="Assets/CanvasLight.jpg" Link="Texturen/Leinwand hell.jpg"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/CanvasDark.jpg" Link="Texturen/Leinwand dunkel.jpg"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/CanvasLightFine.jpg" Link="Texturen/Leinwand hell - fein.jpg"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/CanvasDarkFine.jpg" Link="Texturen/Leinwand dunkel - fein.jpg"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
