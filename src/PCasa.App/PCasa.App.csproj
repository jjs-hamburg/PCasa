<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon Condition="Exists('Assets/PCasa.ico')">Assets/PCasa.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PCasa.Core/PCasa.Core.csproj" />
    <ProjectReference Include="../PCasa.Imaging/PCasa.Imaging.csproj" />
    <Compile Remove="Data/LocalDatabase.cs;Data/OriginalWriteFailureRepository.cs;Services/PcasaDataPaths.cs;Services/PCasaDiagnostics.cs;Services/SourceAvailabilityGate.cs;Services/SchedulerTaskPackage.cs;Services/PCasaScheduler.cs;Services/DurablePackageJournal.cs;Services/SchedulerTaskOrderStore.cs;Services/DurableGalleryTransferJournal.cs;Data/FolderRepository.cs;Data/FolderManagerSelection.cs;Data/FolderManagerSelectionService.cs;Data/ImageCatalogRepository.cs;Data/CatalogChanges.cs;Data/BrowseCacheRepository.cs;Data/BrowseThumbnailProfileRepository.cs;Data/ImageViewerRepository.cs;Models/MonitoredFolder.cs;Models/CatalogImage.cs;Models/BrowseThumbnail.cs;Services/FolderExclusionRules.cs;Services/CatalogInventoryCheck.cs;Services/BackgroundFolderMonitor.cs;Services/VideoFormats.cs;Services/PathClassifier.cs;Services/SourceFilePresence.cs;Services/SourceFileLocks.cs;Services/OriginalFileMutationReceipts.cs;Services/CatalogRemovalService.cs;Services/BackgroundScanSettings.cs;Services/ImageExifReader.cs;Services/ExifToolProcessRegistry.cs;Services/FolderScanner.cs;Services/PackedThumbnailStore.cs;Services/ExifToolKeywordWriter.cs;Services/AdaptiveMetadataWriteTimeout.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="CefSharp.Wpf.NETCore" />
    <PackageReference Include="NetVips" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.D3DCompiler" />
  </ItemGroup>
  
  <ItemGroup Condition="Exists('Assets/PCasa.ico')">
    <Resource Include="Assets/PCasa.ico" />
  </ItemGroup>
  <!-- Single embedded translation catalog; no external deployment dependency. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/gps-map.html" LogicalName="PCasa.App.Resources.gps-map.html" />
    <!-- CI provides the pinned, redistributable BSD-3 MapLibre assets.
         A developer build without them still uses the existing CDN fallback. -->
    <EmbeddedResource Include="Resources/maplibre-gl.js"
                      LogicalName="PCasa.App.Resources.maplibre-gl.js"
                      Condition="Exists('Resources/maplibre-gl.js')" />
    <EmbeddedResource Include="Resources/maplibre-gl.css"
                      LogicalName="PCasa.App.Resources.maplibre-gl.css"
                      Condition="Exists('Resources/maplibre-gl.css')" />
    <EmbeddedResource Include="Resources/english.json"
                      LogicalName="PCasa.App.Resources.english.json" />
    <!-- PCasa copyright/license and distribution notice are packaged with both Setup and ZIP. -->
    <Content Include="../../LICENSE" Link="Licenses/PCasa-GPL-3.0.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-APACHE-2.0.txt" Link="Licenses/Apache-2.0.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-MIT-Microsoft.txt" Link="Licenses/MIT-Microsoft.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-MIT-Vortice.txt" Link="Licenses/MIT-Vortice.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-MIT-NetVips.txt" Link="Licenses/MIT-NetVips.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-LGPL-3.0.txt" Link="Licenses/LGPL-3.0.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="Licenses/THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-README.txt" Link="Licenses/README.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-CEF-LIBVIPS-GUIDE.txt" Link="Licenses/CEF-LIBVIPS-GUIDE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSES-NATIVE-BUILD-VERSIONS.txt" Link="Licenses/NATIVE-BUILD-VERSIONS.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Fixed, version-specific native license baseline: copied as files, not
         fetched at every build. This is evidence for the pinned Windows native
         component set and travels in both the portable and setup payload. -->
    <Content Include="../../license-baseline/libvips-8.18.7/**/*"
             Link="Licenses/Native/libvips-8.18.7/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- Original ExifTool 13.59 upstream text; the immutable Windows
         Strawberry Perl bundle's own Licenses_Strawberry_Perl.zip is
         independently installed next to the bundled executable. -->
    <Content Include="../../license-baseline/exiftool-13.59/**/*"
             Link="Licenses/Native/exiftool-13.59/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- Redistributed MapLibre BSD-3 and third-party attributions. -->
    <Content Include="Resources/maplibre-LICENSE.txt"
             Link="Licenses/MapLibre-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="../../PCasa.Version.props" />
</Project>
