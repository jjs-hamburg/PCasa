<Window x:Class="PCasa.App.BrowseCacheProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCasa – Vorschaudaten"
        Width="365" Height="92" MinWidth="365" MaxWidth="365"
        MinHeight="92" MaxHeight="410"
        ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="{DynamicResource PcasaPanelBrush}" Foreground="{DynamicResource PcasaTextBrush}">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
        </Style>
    </Window.Resources>
    <Grid Margin="8,5" Background="Transparent"
          MouseLeftButtonDown="DialogDrag_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="48" Height="48"
                BorderThickness="1" BorderBrush="{DynamicResource PcasaDividerBrush}"
                Background="{DynamicResource PcasaPanelAltBrush}" VerticalAlignment="Center">
            <Image x:Name="CurrentThumbnail" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <StackPanel Grid.Column="1" Margin="7,0,0,0"
                    VerticalAlignment="Center">
            <TextBlock x:Name="PhaseText" Text="Vorschaudaten werden vorbereitet"
                       FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="CurrentFileText" Text="Einlesen …"
                       FontSize="11" Opacity="0.75"
                       TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
            <ProgressBar x:Name="Progress" Height="7" Minimum="0"
                         Maximum="1" Value="0" Margin="0,7,0,0" />
            <DockPanel Margin="0,4,0,0" LastChildFill="True">
                <Button Content="Im Hintergrund" DockPanel.Dock="Right"
                        Padding="7,2" FontSize="10"
                        Style="{StaticResource PcasaStatusButtonStyle}"
                        Click="Hide_Click" />
                <TextBlock x:Name="CountText" Text="0 / 0"
                           FontSize="11" Opacity="0.8"
                           VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>