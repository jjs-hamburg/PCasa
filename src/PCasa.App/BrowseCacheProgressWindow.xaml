<Window x:Class="PCasa.App.BrowseCacheProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCasa – Vorschaudaten"
        Width="348" Height="76" MinWidth="348" MaxWidth="348"
        MinHeight="76" MaxHeight="76"
        ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="{DynamicResource PcasaPanelBrush}" Foreground="{DynamicResource PcasaTextBrush}">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
        </Style>
    </Window.Resources>
    <Grid Margin="7,4" Background="Transparent"
          MouseLeftButtonDown="DialogDrag_MouseLeftButtonDown"
          MouseMove="DialogDrag_MouseMove"
          MouseLeftButtonUp="DialogDrag_MouseLeftButtonUp"
          LostMouseCapture="DialogDrag_LostMouseCapture">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="42" Height="42"
                BorderThickness="1" BorderBrush="{DynamicResource PcasaDividerBrush}"
                Background="{DynamicResource PcasaPanelAltBrush}" VerticalAlignment="Center">
            <Image x:Name="CurrentThumbnail" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <StackPanel Grid.Column="1" Margin="6,0,0,0"
                    VerticalAlignment="Center">
            <TextBlock x:Name="PhaseText" Text="Vorschaudaten werden vorbereitet"
                       FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="CurrentFileText" Text="Einlesen …"
                       FontSize="11" Opacity="0.75"
                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            <ProgressBar x:Name="Progress" Height="6" Minimum="0"
                         Maximum="1" Value="0" Margin="0,4,0,0" />
            <DockPanel Margin="0,3,0,0" LastChildFill="True">
                <Button Content="Im Hintergrund" DockPanel.Dock="Right"
                        Padding="6,1" FontSize="10"
                        Style="{StaticResource PcasaStatusButtonStyle}"
                        Click="Hide_Click" />
                <TextBlock x:Name="CountText" Text="0 / 0"
                           FontSize="11" Opacity="0.8"
                           VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>