<Application x:Class="PCasa.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             StartupUri="MainWindow.xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="PcasaWindowBrush" po:Freeze="False" Color="#202122" />
        <SolidColorBrush x:Key="PcasaTopBrush" po:Freeze="False" Color="#1A1B1D" />
        <SolidColorBrush x:Key="PcasaPanelBrush" po:Freeze="False" Color="#252628" />
        <SolidColorBrush x:Key="PcasaPanelAltBrush" po:Freeze="False" Color="#2B2C2F" />
        <SolidColorBrush x:Key="PcasaTextBrush" po:Freeze="False" Color="#E7E7E7" />
        <SolidColorBrush x:Key="PcasaMutedTextBrush" po:Freeze="False" Color="#A9AAAC" />
        <SolidColorBrush x:Key="PcasaDividerBrush" po:Freeze="False" Color="#383A3D" />
        <SolidColorBrush x:Key="PcasaSelectionBrush" Color="#42474B" />
        <SolidColorBrush x:Key="PcasaHoverBrush" Color="#303235" />
        <SolidColorBrush x:Key="PcasaAccentBrush" Color="#25A4F4" />

        <!-- Controls shared by the main window, detached popups and modeless dialogs. -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PcasaPanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PcasaDividerBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PcasaTextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource PcasaSelectionBrush}" />
        </Style>
        <!-- Context menus own their entire visual tree, including the icon gutter
             and separators, instead of mixing WPF's native menu chrome with PCasa. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PcasaPanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PcasaDividerBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="2">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="7,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource PcasaDividerBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Context menu items use PCasa's own layout, not the native theme's
             white icon/checkmark gutter. The main menu overrides this template locally. -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PcasaPanelBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBackground" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MenuCheck" Grid.Column="0" Text="✓"
                                           Foreground="{TemplateBinding Foreground}"
                                           Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock x:Name="MenuArrow" Grid.Column="2" Text="›"
                                           Foreground="{TemplateBinding Foreground}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBackground" Property="Background"
                                        Value="{DynamicResource PcasaHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MenuCheck" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="MenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PcasaPanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PcasaDividerBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
        </Style>
        <Style x:Key="PcasaStatusButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PcasaPanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PcasaDividerBrush}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource PcasaHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.53"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThumbnailButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideToolTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PcasaMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,18" />
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="PcasaTreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow"
                                  Width="5"
                                  Height="7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Fill="#989B9E"
                                  Stretch="Fill"
                                  RenderTransformOrigin="0.5,0.5"
                                  Data="M 0,0 L 5,3.5 L 0,7 Z" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#D0D2D4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Compact Picasa-like folder navigation:
            - real representative thumbnail = images exist directly in this folder
            - small folder glyph = structural folder only
            - the thin expander triangle independently indicates child folders
            - horizontal scrolling is disabled; long names are clipped/ellipsized
        -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Height="20" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="19" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="17"
                                  Height="14"
                                  Margin="0,0,2,0"
                                  VerticalAlignment="Center">
                                <Path x:Name="FolderGlyph"
                                      Visibility="Collapsed"
                                      Fill="#B89A61"
                                      Stroke="#7F6942"
                                      StrokeThickness="0.65"
                                      Stretch="Fill"
                                      Data="M 0.5,3.5 L 5,3.5 L 6.3,1.5 L 10.2,1.5 L 11.5,3.5 L 14.5,3.5 L 14.5,12.5 L 0.5,12.5 Z" />

                                <Border x:Name="PhotoFrame"
                                        Width="17"
                                        Height="14"
                                        Background="#171819"
                                        BorderBrush="#777B7F"
                                        BorderThickness="0.5"
                                        SnapsToDevicePixels="True">
                                    <Image Source="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.ThumbnailSource}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="LowQuality"
                                           SnapsToDevicePixels="True" />
                                </Border>
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PcasaTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       ToolTip="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.FullPath}"
                                       ToolTipOpening="FolderNameText_ToolTipOpening" />
                            <TextBlock x:Name="FolderStatusIcon" Grid.Column="2"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"
 />
                            <Ellipse Grid.Column="3" Width="7" Height="7"
                                     Fill="#DF4A54" HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     ToolTip="Tag-Änderungen noch nicht in Originaldateien geschrieben">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.HasPendingTagWrites}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Grid.Column="3" Width="7" Height="7"
                                     Stroke="#DF4A54" StrokeThickness="1.5"
                                     Fill="Transparent" HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     ToolTip="Tag-Schreibvorgänge in Unterordnern ausstehend">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.HasPendingChildTagWrites}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.PhotoFolderId}"
                                         Value="{x:Null}">
                                <Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PhotoFrame" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.StatusCode}" Value="Ready">
                                <Setter TargetName="FolderStatusIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="FolderStatusIcon" Property="Text" Value="✓"/>
                                <Setter TargetName="FolderStatusIcon" Property="Foreground" Value="#4BA26A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.StatusCode}" Value="Working">
                                <Setter TargetName="FolderStatusIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="FolderStatusIcon" Property="Text" Value="↻"/>
                                <Setter TargetName="FolderStatusIcon" Property="Foreground" Value="#56A9D8"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.StatusCode}" Value="Pending">
                                <Setter TargetName="FolderStatusIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="FolderStatusIcon" Property="Text" Value="◷"/>
                                <Setter TargetName="FolderStatusIcon" Property="Foreground" Value="#A7A7A7"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.StatusCode}" Value="Unknown">
                                <Setter TargetName="FolderStatusIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="FolderStatusIcon" Property="Text" Value="?"/>
                                <Setter TargetName="FolderStatusIcon" Property="Foreground" Value="#A7A7A7"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.StatusCode}" Value="Offline">
                                <Setter TargetName="FolderStatusIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="FolderStatusIcon" Property="Text" Value="⊘"/>
                                <Setter TargetName="FolderStatusIcon" Property="Foreground" Value="#E27A72"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=Tag.StatusCode}" Value="Failed">
                                <Setter TargetName="FolderStatusIcon" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="FolderStatusIcon" Property="Text" Value="!"/>
                                <Setter TargetName="FolderStatusIcon" Property="Foreground" Value="#E27A72"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          Style="{StaticResource PcasaTreeExpanderStyle}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                            <Border x:Name="HeaderBorder"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="1"
                                    Padding="1,0,2,0"
                                    ClipToBounds="True">
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True" />
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="12,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource PcasaSelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>