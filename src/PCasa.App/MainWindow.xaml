  <Button x:Name="GpsPlaceSearchClearButton" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" Style="{StaticResource PcasaSearchClearButtonStyle}" ToolTip="{loc:Tr Key='Suchfilter löschen'}" Visibility="Collapsed" Click="GpsPlaceSearchClear_Click"/>
  <Button x:Name="GpsPlaceSearchButton" Grid.Column="1" Margin="4,0,0,0" Padding="8,2" Content="{loc:Tr Key='Suchen'}" Click="GpsPlaceSearch_Click"/>
