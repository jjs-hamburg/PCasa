                </Grid>
            </Border>

            <GridSplitter x:Name="FolderSidebarSplitter" Grid.Column="1"
                          DragStarted="WorkspaceSplitter_DragStarted"
                          DragCompleted="WorkspaceSplitter_DragCompleted"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Background="{DynamicResource PcasaDividerBrush}"
                          Cursor="SizeWE" />

            <Grid Grid.Column="2" Background="{DynamicResource PcasaWindowBrush}">
                <Grid SizeChanged="BrowseGalleryViewport_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- This narrow row is OUTSIDE the scrollable gallery.
                         Its folder titles and photos retain their own virtual layout. -->
                    <Border x:Name="GalleryNavigationBar" Grid.Row="0" Height="33"
                            Background="{DynamicResource PcasaPanelBrush}"
                            BorderBrush="{DynamicResource PcasaDividerBrush}" BorderThickness="0,0,0,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=PhotoViewerPanel}" Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,1,9,1">
                            <!-- These NEW symbols precede the SIX unchanged approved icons. -->
                            <primitives:ToggleButton x:Name="GalleryRememberPositionToggle"
                                     Width="30" Height="27" Padding="2" Margin="2,0,3,0"
                                     ToolTip="{loc:Tr Key='Aktuelle Position merken'}"
                                     Checked="GalleryRememberPosition_Changed"
                                     Unchecked="GalleryRememberPosition_Changed" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="20" Height="20" Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <!-- Recognizable tilted pushpin: head, two tapered shoulders, pointed needle. -->
                                        <Path Data="M 15,2 L 22,9 L 18,10 L 15,13 L 17,16 L 14,19 L 5,10 L 8,7 L 11,9 L 14,6 Z M 10,15 L 3,22"
                                              Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="2.1"
                                              StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </primitives:ToggleButton>
                            <Button x:Name="GalleryReturnToRememberedButton"
                                    Width="30" Height="27" Padding="2" Margin="2,0,2,0"
                                    Style="{StaticResource PcasaStatusButtonStyle}"
                                    ToolTip="{loc:Tr Key='Springt zur gemerkten Position. Zuerst mit der Stecknadel eine Position merken.'}"
                                    IsEnabled="False" Click="GalleryReturnToRemembered_Click" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="20" Height="20" Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="5" Canvas.Top="5" Width="14" Height="14"
                                                 Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="2" Fill="Transparent"/>
                                        <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4"
                                                 Fill="{DynamicResource PcasaTextBrush}"/>
                                        <Path Data="M 12,1 V 7 M 12,17 V 23 M 1,12 H 7 M 17,12 H 23"
                                              Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="GalleryReturnToDepartureButton"
                                    Width="30" Height="27" Padding="2" Margin="2,0,7,0"
                                    Style="{StaticResource PcasaStatusButtonStyle}"
                                    ToolTip="{loc:Tr Key='Kehrt nach einem Sprung zur vorherigen Position zurück. Erst eine Position merken und anspringen.'}"
                                    IsEnabled="False" Click="GalleryReturnToDeparture_Click" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="20" Height="20" Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <!-- Single U-turn arrow, deliberately distinct from the target symbol. -->
                                        <Path Data="M 9,6 L 3,12 L 9,18 M 3,12 H 15 Q 21,12 21,18 V 21"
                                              Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="GalleryNavigateFolderStartButton" Width="30" Height="27" Margin="2,0"
                                     Padding="2" Style="{StaticResource PcasaStatusButtonStyle}"
                                     ToolTip="{loc:Tr Key='Ordneranfang'}" Tag="FolderStart"
                                     Click="GalleryNavigate_Click" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M 4,4 H 20 V 20 H 4 Z M 9,6 V 18 M 17,9 L 12,12 L 17,15" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox>
                            </Button>
                            <Button x:Name="GalleryNavigateFolderEndButton" Width="30" Height="27" Margin="2,0"
                                     Padding="2" Style="{StaticResource PcasaStatusButtonStyle}"
                                     ToolTip="{loc:Tr Key='Ordnerende'}" Tag="FolderEnd"
                                     Click="GalleryNavigate_Click" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M 4,4 H 20 V 20 H 4 Z M 15,6 V 18 M 7,9 L 12,12 L 7,15" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox>
                            </Button>
                            <Button x:Name="GalleryNavigatePreviousFolderButton" Width="30" Height="27" Margin="2,0"
                                     Padding="2" Style="{StaticResource PcasaStatusButtonStyle}"
                                     ToolTip="{loc:Tr Key='Einen Ordner höher'}" Tag="PreviousFolder"
                                     Click="GalleryNavigate_Click" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M 2,3 H 9 L 12,6 H 22 V 22 H 2 Z M 12,20 V 8 M 7,13 L 12,8 L 17,13" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox>
                            </Button>
                            <Button x:Name="GalleryNavigateNextFolderButton" Width="30" Height="27" Margin="2,0"
                                     Padding="2" Style="{StaticResource PcasaStatusButtonStyle}"
                                     ToolTip="{loc:Tr Key='Einen Ordner tiefer'}" Tag="NextFolder"
                                     Click="GalleryNavigate_Click" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M 2,3 H 9 L 12,6 H 22 V 22 H 2 Z M 12,8 V 20 M 7,15 L 12,20 L 17,15" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox>
                            </Button>
                            <Button x:Name="GalleryNavigateGalleryStartButton" Width="30" Height="27" Margin="2,0"
                                     Padding="2" Style="{StaticResource PcasaStatusButtonStyle}"
                                     ToolTip="{loc:Tr Key='Galerieanfang'}" Tag="GalleryStart"
                                     Click="GalleryNavigate_Click" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M 5,11 L 12,4 L 19,11 M 5,17 L 12,10 L 19,17 M 4,21 H 20" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" Fill="Transparent"/></Canvas></Viewbox>
                            </Button>
                            <Button x:Name="GalleryNavigateGalleryEndButton" Width="30" Height="27" Margin="2,0"
                                     Padding="2" Style="{StaticResource PcasaStatusButtonStyle}"
                                     ToolTip="{loc:Tr Key='Galerieende'}" Tag="GalleryEnd"
                                     Click="GalleryNavigate_Click" ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Path Data="M 5,5 L 12,12 L 19,5 M 5,11 L 12,18 L 19,11 M 4,21 H 20" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" Fill="Transparent"/></Canvas></Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- Gallery owns one unchanged ScrollViewer. Only its
                         vertical chrome is replaced; virtualization and
                         gallery update/anchor rules stay exactly as before. -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="BrowseScrollViewer" Grid.Column="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      CanContentScroll="False"
                                      PanningMode="VerticalOnly"
                                      PreviewMouseWheel="BrowseScrollViewer_PreviewMouseWheel"
                                      ScrollChanged="BrowseScrollViewer_ScrollChanged">
                            <controls:BrowseGallerySurface x:Name="BrowseSurface"
                                                           Loaded="BrowseSurface_Loaded"
                                                           AllowDrop="True"
                                                           DragOver="GalleryFiles_DragOver"
                                                           DragLeave="DragTarget_Leave"
                                                           Drop="GalleryFiles_Drop"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Top" />
                        </ScrollViewer>
                        <controls:PicasaGalleryScrollBar x:Name="PicasaGalleryScrollBar"
                                                        Grid.Column="1"
                                                        Loaded="PicasaGalleryScrollBar_Loaded" />
                    </Grid>

                    <Grid x:Name="PhotoViewerPanel" Grid.Row="1"
                          Visibility="Collapsed"
                          Background="{Binding Background, ElementName=BrowseScrollViewer}"
                          Focusable="True"
                          PreviewKeyDown="PhotoViewerPanel_PreviewKeyDown"
                          IsManipulationEnabled="True"
                          ManipulationStarting="PhotoViewer_ManipulationStarting"
                          ManipulationDelta="PhotoViewer_ManipulationDelta"
                          ManipulationCompleted="PhotoViewer_ManipulationCompleted"
                          PreviewMouseLeftButtonDown="PhotoViewerPanel_MouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="PhotoViewerPan_MouseLeftButtonUp"
                          PreviewMouseMove="PhotoViewerPan_MouseMove"
                          MouseRightButtonDown="PhotoViewerPanel_MouseRightButtonDown">
                        <ScrollViewer x:Name="PhotoViewerScroller"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="False"
                                      Background="Transparent"
                                      SizeChanged="PhotoViewerViewport_SizeChanged"
                                      ScrollChanged="PhotoViewerScroller_ScrollChanged">
                            <Grid x:Name="PhotoViewerCanvas"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Background="Transparent">
                                <Image x:Name="PhotoViewerImage"
                                       Stretch="Fill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Canvas x:Name="ViewerCropOverlay" Visibility="Collapsed"
                                        Width="{Binding ActualWidth, ElementName=PhotoViewerImage}"
                                        Height="{Binding ActualHeight, ElementName=PhotoViewerImage}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Panel.ZIndex="2" Background="Transparent">
                                    <Rectangle x:Name="ViewerCropShadeTop" Fill="#99000000" IsHitTestVisible="False"/>
                                    <Rectangle x:Name="ViewerCropShadeBottom" Fill="#99000000" IsHitTestVisible="False"/>
                                    <Rectangle x:Name="ViewerCropShadeLeft" Fill="#99000000" IsHitTestVisible="False"/>
                                    <Rectangle x:Name="ViewerCropShadeRight" Fill="#99000000" IsHitTestVisible="False"/>
                                    <Line x:Name="ViewerCropHoverLeft" Stroke="#FFFFFF" StrokeThickness="2.4" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <Line x:Name="ViewerCropHoverRight" Stroke="#FFFFFF" StrokeThickness="2.4" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <Line x:Name="ViewerCropHoverTop" Stroke="#FFFFFF" StrokeThickness="2.4" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <Line x:Name="ViewerCropHoverBottom" Stroke="#FFFFFF" StrokeThickness="2.4" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <Rectangle x:Name="ViewerCropOutline" Stroke="#F1F1F1"
                                               StrokeThickness="1.2" Fill="#0AFFFFFF"
                                               IsHitTestVisible="False"/>
                                    <Line x:Name="ViewerCropThirdV1" Stroke="#A6FFFFFF" StrokeThickness=".8" IsHitTestVisible="False"/>
                                    <Line x:Name="ViewerCropThirdV2" Stroke="#A6FFFFFF" StrokeThickness=".8" IsHitTestVisible="False"/>
                                    <Line x:Name="ViewerCropThirdH1" Stroke="#A6FFFFFF" StrokeThickness=".8" IsHitTestVisible="False"/>
                                    <Line x:Name="ViewerCropThirdH2" Stroke="#A6FFFFFF" StrokeThickness=".8" IsHitTestVisible="False"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                        <Grid x:Name="ComparisonPanel" Visibility="Collapsed"
                              Background="{Binding Background, ElementName=BrowseScrollViewer}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="ComparisonImageA" Grid.Column="0" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border Grid.Column="1" Background="#444444"/>
                            <Image x:Name="ComparisonImageB" Grid.Column="2" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <controls:PhotoZoomNavigator x:Name="PhotoViewerNavigator" />
                        <Border x:Name="PhotoViewerQualityBanner"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="14"
                                Padding="9,5"
                                Background="#D9262729"
                                CornerRadius="3"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="PhotoViewerQualityText"
                                       Foreground="#E6E6E6"
                                       FontSize="12" />
                        </Border>
                    </Grid>

                    <StackPanel x:Name="EmptyPanel" Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="EmptyPanelHeading" Text="{loc:Tr Key='Noch keine Bilder im Katalog'}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyPanelDescription" Text="{loc:Tr Key='Ordner im Menü einlesen, um die Galerie zu füllen.'}"
                                   Foreground="{DynamicResource PcasaMutedTextBrush}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="BrowseCachePanel" Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="24,18"
                            Background="#E6252628"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <StackPanel Width="440">
                            <TextBlock Text="{loc:Tr Key='Vorschaudaten werden vorbereitet'}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="BrowseCacheProgressText"
                                       Margin="0,8,0,10"
                                       Foreground="{DynamicResource PcasaMutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       Text="0 / 0" />
                            <ProgressBar x:Name="BrowseCacheProgressBar"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter x:Name="InfoSidebarSplitter" Grid.Column="3"
                          Width="5" Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          DragStarted="WorkspaceSplitter_DragStarted"
                          DragCompleted="WorkspaceSplitter_DragCompleted"
                          Background="{DynamicResource PcasaDividerBrush}"
                          Cursor="SizeWE" />

            <Border x:Name="InfoSidebarPanel" Grid.Column="4"
                    Visibility="Collapsed"
                    Background="{DynamicResource PcasaPanelBrush}">
                <Grid Margin="10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="InfoSidebarHeader" Margin="4,0,0,9">
 <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBlock x:Name="SidePanelHeading" Grid.Column="0" Text="{loc:Tr Key='Bildinformationen'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
 <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
 <TextBlock x:Name="GpsCoordinatesText" Visibility="Collapsed" Margin="11,0,2,0" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{loc:Tr Key='GPS-Positionen werden geladen'}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  <Button x:Name="GpsCopyButton" Height="29" Padding="3,1" Margin="2,0,5,0" IsEnabled="False" Width="27" Click="GpsCopy_Click" ToolTip="{loc:Tr Key='Kopiert die GPS-Koordinaten eines ausgewählten Fotos. Ohne gültige Koordinaten nicht verfügbar.'}" ToolTipService.ShowOnDisabled="True"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PcasaStatusButtonStyle}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style>
 <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Rectangle Canvas.Left="7" Canvas.Top="7" Width="13" Height="14" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.7"/><Path Data="M4,17 V3 H17 V5" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.7" Fill="Transparent"/></Canvas></Viewbox>
 </Button>
 </StackPanel>
 <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">

 <Button x:Name="GpsExpandButton" Width="33" Height="31" Padding="0" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="{loc:Tr Key='GPS-Leiste vergrößern'}" Style="{StaticResource PcasaStatusButtonStyle}" Click="GpsExpand_Click">
 <Viewbox Width="20" Height="20"><Canvas Width="32" Height="32"><Path Data="M28,5 L28,27" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.6"/><Path x:Name="GpsExpandArrow" Data="M25,16 L6,16 M15,7 L6,16 L15,25" Stroke="{DynamicResource PcasaTextBrush}" Fill="Transparent" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
 </Button>
 <Button x:Name="GpsFullscreenButton" Width="33" Height="31" Padding="0" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="{loc:Tr Key='GPS-Vollbild'}" Style="{StaticResource PcasaStatusButtonStyle}" Click="GpsFullscreen_Click">
 <Viewbox Width="20" Height="20"><Canvas Width="32" Height="32"><Path x:Name="GpsFullscreenCorners" Data="M12,4 L4,4 L4,12 M20,4 L28,4 L28,12 M28,20 L28,28 L20,28 M12,28 L4,28 L4,20" Stroke="{DynamicResource PcasaTextBrush}" Fill="Transparent" StrokeThickness="1.65" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/></Canvas></Viewbox>
 </Button>
 <Button x:Name="CloseSidebarButton" Width="31" Height="31" Padding="0" Style="{StaticResource PcasaStatusButtonStyle}" ToolTip="{loc:Tr Key='Seitenleiste schließen'}" Click="CloseSidebar_Click"><ContentControl Template="{StaticResource PcasaCloseGlyphTemplate}" Width="19" Height="19"/></Button>
 </StackPanel></Grid>
                    <ScrollViewer x:Name="GeneralSidebarScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="SidePanelText" TextWrapping="Wrap" FontSize="12"/>
                            <Button x:Name="InfoCopyGpsButton" Visibility="Collapsed"
                                    HorizontalAlignment="Left" Margin="0,7,0,0"
                                    Padding="7,3" Click="InfoCopyGps_Click"
                                    ToolTip="{loc:Tr Key='GPS-Koordinaten kopieren'}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M5,3 H15 L20,8 V21 H5 Z M15,3 V8 H20"
                                                  Stroke="{DynamicResource PcasaTextBrush}"
                                                  Fill="Transparent" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{loc:Tr Key='GPS kopieren'}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="GpsMapPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="0"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource PcasaToolbarFrameBrush}"
         BorderThickness="1" CornerRadius="5" Padding="7"
         Margin="0,0,0,5">
 <Grid x:Name="GpsControlsPanel" Grid.Row="0">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Grid.Row="0" Margin="0,0,0,4">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBox x:Name="GpsPlaceSearchBox" Grid.Column="0" Height="27" VerticalContentAlignment="Center" Padding="29,0,28,0"
    ToolTip="{loc:Tr Key='Ort, Adresse oder Sehenswürdigkeit suchen'}" KeyDown="GpsPlaceSearch_KeyDown" TextChanged="GpsPlaceSearch_TextChanged"/>
  <ContentControl Grid.Column="0" Template="{StaticResource PcasaSearchMagnifierTemplate}"
