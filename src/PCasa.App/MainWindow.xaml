<Window x:Class="PCasa.App.MainWindow"
        xmlns:loc="clr-namespace:PCasa.App.Services"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PCasa.App.Controls"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="PCasa"
        Width="1500"
        Height="920"
        MinWidth="1000"
        MinHeight="650"
        Background="{DynamicResource PcasaWindowBrush}"
        Foreground="{DynamicResource PcasaTextBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="BackgroundScan_WindowLoaded"
        Closed="BackgroundScan_WindowClosed"
        PreviewKeyDown="PhotoViewerWindow_PreviewKeyDown">
    <Window.Resources>
        <!-- One continuous 35-mm-inspired perforation pattern. The strip
             background is independent of item virtualization/scrolling. -->
        <DrawingBrush x:Key="GpsFilmPerforationBrush" TileMode="Tile"
                      Viewport="0,0,26,12" ViewportUnits="Absolute"
                      Viewbox="0,0,26,12" ViewboxUnits="Absolute" Stretch="Fill">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#CFD1D2">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="6.5,2,13,8" RadiusX="1.6" RadiusY="1.6"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- The native ScrollViewer owns scrolling and virtualization. Its
             scrollbar sits BELOW both uninterrupted sprocket-hole bands. -->
        <ControlTemplate x:Key="GpsFilmstripScrollViewerTemplate"
                         TargetType="{x:Type ScrollViewer}">
            <Grid x:Name="GpsFilmTrack" Background="#0D0E0F">
                <Grid.RowDefinitions>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Rectangle x:Name="GpsFilmPerforationsTop" Grid.Row="0"
                           Fill="{StaticResource GpsFilmPerforationBrush}"
                           IsHitTestVisible="False"/>
                <Border Grid.Row="1" Background="#17191B"
                        BorderBrush="#292B2D" BorderThickness="0,1">
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            CanContentScroll="{TemplateBinding CanContentScroll}"/>
                </Border>
                <Rectangle x:Name="GpsFilmPerforationsBottom" Grid.Row="2"
                           Fill="{StaticResource GpsFilmPerforationBrush}"
                           IsHitTestVisible="False"/>
                <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="3"
                           Height="16" Orientation="Horizontal"
                           Background="#202224"
                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                           Maximum="{TemplateBinding ScrollableWidth}"
                           ViewportSize="{TemplateBinding ViewportWidth}"
                           Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="GpsFilmstripListTemplate" TargetType="{x:Type ListBox}">
            <ScrollViewer x:Name="GpsFilmScrollViewer"
                          Focusable="False"
                          Template="{StaticResource GpsFilmstripScrollViewerTemplate}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <ItemsPresenter/>
            </ScrollViewer>
        </ControlTemplate>

        <!-- Explicit item template: WPF's system ListBoxItem template paints
             a large blue selected block. Selection is instead a subtle,
             high-contrast border, distinguishable without color perception. -->
        <Style x:Key="GpsFilmFrameItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D3D5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="FilmFrame" Margin="1" Padding="0"
                                Background="#151719" BorderBrush="#383B3E"
                                BorderThickness="1" CornerRadius="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Content"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilmFrame" Property="Background" Value="#252729"/>
                                <Setter TargetName="FilmFrame" Property="BorderBrush" Value="#8B8D8F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FilmFrame" Property="Background" Value="#292C2E"/>
                                <Setter TargetName="FilmFrame" Property="BorderBrush" Value="#E3E1DC"/>
                                <Setter TargetName="FilmFrame" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GPS place results use the shared PCasa palette, never the
             system ComboBox's white collapsed field or selection chrome. -->
        <Style x:Key="GpsPlaceResultItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="HitBackground"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HitBackground" Property="Background"
                                        Value="{DynamicResource PcasaHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HitBackground" Property="Background"
                                        Value="{DynamicResource PcasaSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PcasaLogicSymbolStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26" Background="Transparent">
                            <Ellipse x:Name="Ring" Margin="2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource PcasaAccentBrush}"/>
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Shared Picasa-like 29 px icon buttons; no separate interaction model. -->
        <Style x:Key="PcasaFooterIconButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PcasaStatusButtonStyle}">
            <Setter Property="Width" Value="29"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <Style x:Key="PcasaFolderIconButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PcasaFooterIconButtonStyle}">
            <Setter Property="Width" Value="31"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outline" CornerRadius="4"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Effect="{StaticResource PcasaButtonShadow}">
                            <Grid>
                                <Border x:Name="FolderButtonDepth" IsHitTestVisible="False"
                                        CornerRadius="3" Background="{StaticResource PcasaButtonDepthBrush}"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Outline" Property="Background" Value="{DynamicResource PcasaSearchActiveBrush}"/>
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource PcasaAccentBrush}"/>
                                <Setter TargetName="Outline" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveGold">
                                <Setter TargetName="Outline" Property="Background" Value="{DynamicResource PcasaSearchActiveBrush}"/>
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource PcasaAccentBrush}"/>
                                <Setter TargetName="Outline" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FolderButtonDepth" Property="Opacity" Value="0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="{x:Null}"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Outline" Property="Background" Value="{DynamicResource PcasaHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Shared frame: sort and search have identical outline, fill and shadow. -->
        <Style x:Key="PcasaToolbarGroupFrameStyle" TargetType="Border">
            <Setter Property="Height" Value="37"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PcasaToolbarFrameBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PcasaPanelBrush}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="7" ShadowDepth="2" Opacity="0.27" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Exclusive search groups and NOT use the same blue active frame.
             The redundant check marks are intentionally omitted. -->
        <Style x:Key="PcasaSearchChoiceStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="45"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PcasaPanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PcasaDividerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" CornerRadius="4" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background"
                                        Value="{DynamicResource PcasaHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource PcasaSearchActiveBrush}"/>
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource PcasaAccentBrush}"/>
                                <Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="2"/>
                                <Setter Property="Foreground" Value="{DynamicResource PcasaSearchActiveTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PcasaSearchInvertStyle" TargetType="{x:Type primitives:ToggleButton}">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PcasaPanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PcasaDividerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">
                        <Border x:Name="InvertBorder" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InvertBorder" Property="Background"
                                        Value="{DynamicResource PcasaHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InvertBorder" Property="BorderBrush" Value="{DynamicResource PcasaAccentBrush}"/>
                                <Setter TargetName="InvertBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="InvertBorder" Property="Background" Value="{DynamicResource PcasaSearchActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PcasaSearchActiveTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Approved filigree slider: hairline rail and a small flat round
             grip. A 20x24 transparent hit area keeps it comfortable to drag.
             The existing thumb event handlers and right-hand icons are
             intentionally untouched. -->
        <ControlTemplate x:Key="PcasaCompactSliderThumbTemplate"
                         TargetType="{x:Type primitives:Thumb}">
            <Grid Width="20" Height="24" Background="Transparent"
                  SnapsToDevicePixels="True">
                <Ellipse Width="12" Height="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="#737A81" StrokeThickness="1"
                         Fill="#C1C6CA"/>
            </Grid>
        </ControlTemplate>
        <Style x:Key="PcasaNeutralSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="26" Background="Transparent"
                              SnapsToDevicePixels="True">
                            <Border Height="2" CornerRadius="1"
                                    VerticalAlignment="Center"
                                    Background="#767D84"/>
                            <primitives:Track x:Name="PART_Track" VerticalAlignment="Center"
                                              IsDirectionReversed="False">
                                <primitives:Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  IsTabStop="False" Opacity="0"/>
                                </primitives:Track.DecreaseRepeatButton>
                                <primitives:Track.Thumb>
                                    <primitives:Thumb Width="20" Height="24"
                                        Template="{StaticResource PcasaCompactSliderThumbTemplate}" />
                                </primitives:Track.Thumb>
                                <primitives:Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  IsTabStop="False" Opacity="0"/>
                                </primitives:Track.IncreaseRepeatButton>
                            </primitives:Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Search toolbar sorting dropdown, following the same compact
             visual language as WAS/WO/Nicht without changing any sort logic. -->
        <Style x:Key="PcasaSearchSortButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource PcasaPanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PcasaDividerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SortSelectorBorder" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource PcasaButtonShadow}">
                            <Grid>
                                <Border x:Name="SortSelectorDepth" CornerRadius="3" IsHitTestVisible="False"
                                        Background="{StaticResource PcasaButtonDepthBrush}"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SortSelectorBorder" Property="Background"
                                        Value="{DynamicResource PcasaHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="MainLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Two stable header rows; neither depends on the window width.
             The menu is never measured as the remainder of the search bar. -->
        <Grid Grid.Row="0" Background="{DynamicResource PcasaTopBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" MinHeight="42"
                    Background="{DynamicResource PcasaTopBrush}">
                <Menu x:Name="MainMenu" Background="Transparent"
                      Foreground="{DynamicResource PcasaTextBrush}"
                      VerticalAlignment="Center"
                      Padding="13,0,0,0">
                    <Menu.Resources>
                        <!-- Local menu template only: no application-wide style changes. -->
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
                            <Setter Property="Background" Value="{DynamicResource PcasaPanelBrush}" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type MenuItem}">
                                        <Grid HorizontalAlignment="Stretch" MinWidth="{TemplateBinding MinWidth}">
                                            <Border x:Name="ItemBackground" HorizontalAlignment="Stretch" Background="Transparent">
                                                <Grid Height="28">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="MenuCheckColumn" Width="20"/>
                                                        <ColumnDefinition x:Name="MenuLabelColumn" Width="*"/>
                                                        <ColumnDefinition x:Name="MenuArrowColumn" Width="15"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="CheckMark" Grid.Column="0" Text="✓"
                                                               Visibility="Collapsed" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                    <ContentPresenter x:Name="MenuHeaderPresenter" Grid.Column="1" ContentSource="Header"
                                                                      RecognizesAccessKey="True" VerticalAlignment="Center"
                                                                      Margin="5,0,5,0"/>
                                                    <TextBlock x:Name="SubArrow" Grid.Column="2" Text="›"
                                                               Visibility="Collapsed" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Placement="Custom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                   Loaded="MenuPopup_Loaded" HorizontalOffset="0" VerticalOffset="0"
                                                   AllowsTransparency="True" Focusable="False"
                                                   PopupAnimation="None">
                                                <Border Background="{DynamicResource PcasaPanelBrush}"
                                                        BorderBrush="{DynamicResource PcasaDividerBrush}"
                                                        BorderThickness="1" Padding="1">
                                                    <StackPanel IsItemsHost="True" HorizontalAlignment="Stretch" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Role" Value="TopLevelHeader">
                                                <Setter TargetName="ItemBackground" Property="MinWidth" Value="0"/>
                                                <Setter TargetName="ItemBackground" Property="Padding" Value="0"/>
                                                <Setter TargetName="MenuHeaderPresenter" Property="Margin" Value="8,0,8,0"/>
                                                <!-- Auto, not star: otherwise the drop-down width
                                                     leaks into the top header and creates variable
                                                     text gaps despite identical margins. -->
                                                <Setter TargetName="MenuLabelColumn" Property="Width" Value="Auto"/>
                                                <Setter TargetName="MenuCheckColumn" Property="Width" Value="0"/>
                                                <Setter TargetName="MenuArrowColumn" Property="Width" Value="0"/>
                                            </Trigger>
                                            <!-- A direct action such as Appearance has Role=TopLevelItem,
                                                 unlike dropdown headers (TopLevelHeader). BOTH must
                                                 have ZERO icon/arrow columns and the same text margin. -->
                                            <Trigger Property="Role" Value="TopLevelItem">
                                                <Setter TargetName="ItemBackground" Property="MinWidth" Value="0"/>
                                                <Setter TargetName="ItemBackground" Property="Padding" Value="0"/>
                                                <Setter TargetName="MenuHeaderPresenter" Property="Margin" Value="8,0,8,0"/>
                                                <Setter TargetName="MenuLabelColumn" Property="Width" Value="Auto"/>
                                                <Setter TargetName="MenuCheckColumn" Property="Width" Value="0"/>
                                                <Setter TargetName="MenuArrowColumn" Property="Width" Value="0"/>
                                            </Trigger>
                                            <Trigger Property="Role" Value="SubmenuHeader">
                                                <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource PcasaHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Menu.Resources>
                    <!-- Real TEXT-to-TEXT separation: each top header is
                         its intrinsic text width + 8px per side + 12px gap.
                         The first caption starts 13+8=21px from the edge.
                         Keep all four menu labels naturally sized in DE/EN. -->
                    <MenuItem Header="{loc:Tr Key='Datei'}" Margin="0,0,12,0" HorizontalAlignment="Left">
                        <MenuItem Header="{loc:Tr Key='Beenden'}" Click="FileExit_Click"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr Key='Ordner'}" Margin="0,0,12,0" HorizontalAlignment="Left">
                        <MenuItem Header="{loc:Tr Key='Ordner-Manager...'}"
                                  Click="BrowseFolderManager_Click" />
                        <Separator />
                        <MenuItem x:Name="ScanAllMenuItem"
                                  Header="{loc:Tr Key='Alle überwachten Ordner einlesen'}"
                                  Click="BrowseScanAll_Click" />
                    </MenuItem>
                    <MenuItem x:Name="AppearanceSettingsMenuItem" Header="{loc:Tr Key='Darstellung'}"
                              Margin="0,0,12,0" HorizontalAlignment="Left"
                              Click="AppearanceSettings_Click"/>
                    <MenuItem Header="{loc:Tr Key='Optionen'}" Margin="0,0,12,0" HorizontalAlignment="Left">
                        <MenuItem Header="{loc:Tr Key='Sprache'}">
                            <MenuItem x:Name="LanguageGermanMenu" Header="{loc:Tr Key='Deutsch'}" Tag="de"
                                      IsCheckable="True" Click="AppearanceLanguage_Click"/>
                            <MenuItem x:Name="LanguageEnglishMenu" Header="{loc:Tr Key='Englisch'}" Tag="en"
                                      IsCheckable="True" Click="AppearanceLanguage_Click"/>
                        </MenuItem>
                        <MenuItem Header="GPX..." Click="GpxOptions_Click"/>
                        <MenuItem Header="Bildbearbeitung">
                            <MenuItem Header="Undo..." Click="UndoOptions_Click"/>
                            <MenuItem Header="Bild wiederherstellen..." Click="UndoRestore_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="TaskManagerMenuItem"
                                  Header="{loc:Tr Key='Taskmanager...'}"
                                  Click="TaskManagerMenu_Click"/>
                        <MenuItem Header="{loc:Tr Key='Schreibfehler'}"
                                  Click="WriteErrorsMenu_Click"/>
                        <Separator/>
                        <MenuItem x:Name="DatabaseManagementMenuItem"
                                  Header="{loc:Tr Key='Datenbankverwaltung...'}"
                                  Click="DatabaseManagementMenu_Click"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Tr Key='Hilfe'}" Margin="0,0,12,0"
                              HorizontalAlignment="Left">
                        <MenuItem x:Name="CheckForUpdatesMenuItem"
                                  Header="{loc:Tr Key='Nach Updates suchen'}"
                                  Click="HelpCheckForUpdates_Click"/>
                        <Separator/>
                        <MenuItem x:Name="AboutPcasaMenuItem"
                                  Header="{loc:Tr Key='Über PCasa'}"
                                  Click="HelpAbout_Click"/>
                    </MenuItem>
                </Menu>
            </Border>
            <Border Grid.Row="1" MinHeight="42"
                    Background="{DynamicResource PcasaTopBrush}"
                    BorderBrush="{DynamicResource PcasaDividerBrush}"
                    BorderThickness="0,1,0,1">
                <!-- Preserve the exact controls and order. On narrow windows
                     the search row scrolls; nothing clips or displaces menu. -->
                <ScrollViewer x:Name="SearchToolbarScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              Focusable="False"
                              HorizontalContentAlignment="Right"
                              CanContentScroll="False"
                              Padding="10,3,10,3">
                    <StackPanel x:Name="SearchToolbarPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                    <!-- The inversion toggle has the SAME outer frame as
                         Filter/Sort/Search. Only its inner button changes state. -->
                    <Border x:Name="GalleryInvertSelectionFrame"
                            Style="{StaticResource PcasaToolbarGroupFrameStyle}"
                            Margin="2,0,3,0">
                    <primitives:ToggleButton x:Name="GalleryInvertSelectionToggle"
                              Width="31" Height="27" Padding="2" Margin="0"
                              ToolTip="{loc:Tr Key='Auswahl invertieren (aktueller Ordner)'}"
                              Checked="GalleryInvertSelectionToggle_Changed"
                              Unchecked="GalleryInvertSelectionToggle_Changed">
                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 3,4 H 11 V 12 H 3 Z M 13,12 H 21 V 20 H 13 Z M 14,4 L 20,4 L 20,10 M 20,4 L 12,12 M 10,20 L 4,20 L 4,14 M 4,20 L 12,12"
                                      Stroke="{DynamicResource PcasaTextBrush}"
                                      StrokeThickness="1.65" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </primitives:ToggleButton>
                    </Border>
                    <Border x:Name="GalleryAttributeFilterFrame" Style="{StaticResource PcasaToolbarGroupFrameStyle}" Margin="2,0,3,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- The funnel itself toggles inversion; its shape turns upside down. -->
                            <Button x:Name="GalleryAttributeFilterInvertButton" Width="26" Height="27" Padding="3,0"
                                    Style="{StaticResource PcasaSearchSortButtonStyle}"
                                    ToolTip="{loc:Tr Key='Eigenschaftsfilter umkehren'}"
                                    Click="GalleryAttributeFilterInvert_Click">
                                <Viewbox Width="17" Height="17"><Canvas x:Name="GalleryAttributeFilterFunnel"
                                                  Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                                    <Path Data="M 3,4 L 21,4 L 14,12 L 14,20 L 10,18 L 10,12 Z"
                                          Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round" Fill="Transparent"/>
                                </Canvas></Viewbox>
                            </Button>
                            <Button x:Name="GalleryAttributeFilterSelectorButton" Width="91" Height="27" Padding="6,0"
                                    Style="{StaticResource PcasaSearchSortButtonStyle}"
                                    ToolTip="{loc:Tr Key='Eigenschaftsfilter auswählen'}"
                                    Click="GalleryAttributeFilterSelector_Click">
                                <TextBlock x:Name="GalleryAttributeFilterLabel" Text="Filter" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <Button.ContextMenu><ContextMenu>
                                    <MenuItem x:Name="GalleryAttributeGpsMenu" Header="{loc:Tr Key='Mit GPS'}" Tag="Gps"
                                              IsCheckable="True" Click="GalleryAttributeFilterOption_Click"/>
                                    <MenuItem x:Name="GalleryAttributeTagsMenu" Header="{loc:Tr Key='Mit Tags'}" Tag="Tags"
                                              IsCheckable="True" Click="GalleryAttributeFilterOption_Click"/>
                                    <MenuItem x:Name="GalleryAttributeRawMenu" Header="{loc:Tr Key='Nur RAW'}" Tag="Raw"
                                              IsCheckable="True" Click="GalleryAttributeFilterOption_Click"/>
                                    <MenuItem x:Name="GalleryAttributeVideoMenu" Header="{loc:Tr Key='Nur Videos'}" Tag="Video"
                                              IsCheckable="True" Click="GalleryAttributeFilterOption_Click"/>
                                </ContextMenu></Button.ContextMenu>
                            </Button>
                            <Button x:Name="GalleryAttributeFilterClearButton" Width="27" Height="27" Padding="3,0"
                                    Margin="4,0,0,0" Style="{StaticResource PcasaSearchSortButtonStyle}"
                                    ToolTip="{loc:Tr Key='Eigenschaftsfilter löschen'}"
                                    Click="GalleryAttributeFilterClear_Click">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="19" Height="19"
                                             Stroke="{DynamicResource PcasaDeleteIconBrush}" StrokeThickness="1.9"/>
                                    <Path Data="M 9,9 L 15,15 M 15,9 L 9,15"
                                          Stroke="{DynamicResource PcasaDeleteIconBrush}" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas></Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>
<Border x:Name="GallerySortGroupFrame" Style="{StaticResource PcasaToolbarGroupFrameStyle}" Margin="2,0,8,0">
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
  <Button x:Name="GallerySortSelectorButton" Width="145" Height="27" Margin="0,0,5,0"
    Style="{StaticResource PcasaSearchSortButtonStyle}"
    ToolTip="{loc:Tr Key='Bilder innerhalb jedes Ordners sortieren'}" Click="GallerySortSelector_Click">
   <Button.Content><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Grid x:Name="GallerySortIconPanel" Width="21" Height="20" Margin="0,0,6,0">
     <Path Data="M 2,4 L 17,4 M 2,10 L 12,10 M 2,16 L 7,16"
       Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.8"
       StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
    </Grid>
    <TextBlock x:Name="GallerySortSelectedFieldLabel" Text="Name" FontSize="12" VerticalAlignment="Center"/>
   </StackPanel></Button.Content>
   <Button.ContextMenu><ContextMenu><MenuItem x:Name="GallerySortNameMenu" Header="{loc:Tr Key='Name'}" Tag="Name" IsCheckable="True" Click="GallerySort_Click"/>
<MenuItem x:Name="GallerySortCapturedMenu" Header="{loc:Tr Key='Aufnahmedatum'}" Tag="Captured" IsCheckable="True" Click="GallerySort_Click"/>
<MenuItem x:Name="GallerySortCreatedMenu" Header="{loc:Tr Key='Erstellungsdatum'}" Tag="Created" IsCheckable="True" Click="GallerySort_Click"/>
<MenuItem x:Name="GallerySortModifiedMenu" Header="{loc:Tr Key='Änderungsdatum'}" Tag="Modified" IsCheckable="True" Click="GallerySort_Click"/>
<MenuItem x:Name="GallerySortSizeMenu" Header="{loc:Tr Key='Größe'}" Tag="Size" IsCheckable="True" Click="GallerySort_Click"/>
<MenuItem x:Name="GallerySortDimensionsMenu" Header="{loc:Tr Key='Dimension'}" Tag="Dimensions" IsCheckable="True" Click="GallerySort_Click"/></ContextMenu></Button.ContextMenu>
  </Button>
  <Button x:Name="GallerySortDirectionButton" Width="31" Height="27" FontSize="12" Padding="0"
    Style="{StaticResource PcasaSearchSortButtonStyle}"
    ToolTip="{loc:Tr Key='Sortierrichtung umschalten'}" Click="GallerySortDirection_Click">
   <Viewbox Width="17" Height="20" Stretch="Uniform">
    <Canvas Width="24" Height="24"><Path x:Name="GallerySortDirectionToggleIcon"
     Data="M 12,2 L 12,20 M 6,14 L 12,20 L 18,14"
     Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="2.1"
     StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas>
   </Viewbox>
  </Button>
 </StackPanel>
</Border>
<Border x:Name="SearchGroupFrame" Style="{StaticResource PcasaToolbarGroupFrameStyle}" Margin="0,0,2,0">
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
  <Border x:Name="SearchGroupLeadingMagnifier" Width="27" Height="27"
          Margin="3,0,6,0" CornerRadius="4" BorderThickness="1"
          BorderBrush="{DynamicResource PcasaToolbarFrameBrush}"
          Background="{DynamicResource PcasaPanelAltBrush}"
          Effect="{StaticResource PcasaButtonShadow}" IsHitTestVisible="False">
   <Grid>
    <Border CornerRadius="3" Background="{StaticResource PcasaButtonDepthBrush}" IsHitTestVisible="False"/>
    <ContentControl Template="{StaticResource PcasaSearchMagnifierTemplate}"
                    Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <TextBlock x:Name="SearchWhatCaption" Text="{loc:Tr Key='WAS?'}" FontSize="12"
             Margin="2,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource PcasaTextBrush}"/>
  <RadioButton x:Name="SearchTagsMode" GroupName="SearchMode" Style="{StaticResource PcasaSearchChoiceStyle}"
    IsChecked="True" Checked="SearchMode_Changed" Content="{loc:Tr Key='Tags'}"
    ToolTip="{loc:Tr Key='Nach Tags filtern'}"/>
  <RadioButton x:Name="SearchFileNameMode" GroupName="SearchMode" Style="{StaticResource PcasaSearchChoiceStyle}"
    Checked="SearchMode_Changed" Content="{loc:Tr Key='Name'}"
    ToolTip="{loc:Tr Key='Nach Dateinamen filtern'}"/>
  <TextBlock x:Name="SearchWhereCaption" Text="{loc:Tr Key='WO?'}" FontSize="12"
             Margin="12,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource PcasaTextBrush}"/>
  <RadioButton x:Name="SearchAllScope" GroupName="TagSearchScope" Style="{StaticResource PcasaSearchChoiceStyle}"
    IsChecked="True" Checked="TagSearchScope_Changed" Content="{loc:Tr Key='Alle'}"
    ToolTip="{loc:Tr Key='Alle überwachten Ordner'}"/>
  <RadioButton x:Name="SearchTreeScope" GroupName="TagSearchScope" Style="{StaticResource PcasaSearchChoiceStyle}"
    Checked="TagSearchScope_Changed" Content="{loc:Tr Key='Ab hier'}"
    ToolTip="{loc:Tr Key='Ausgewählter Ordnerbaum einschließlich Unterordner'}"/>
  <RadioButton x:Name="SearchCurrentScope" GroupName="TagSearchScope" Style="{StaticResource PcasaSearchChoiceStyle}"
    Checked="TagSearchScope_Changed" Content="{loc:Tr Key='Ordner'}"
    ToolTip="{loc:Tr Key='Nur aktueller Ordner ohne Unterordner'}"/>
  <primitives:ToggleButton x:Name="GalleryViewFilterToggle" Margin="9,0,3,0"
    Style="{StaticResource PcasaSearchInvertStyle}" Content="{loc:Tr Key='Galerieansicht'}"
    ToolTip="{loc:Tr Key='Suche auf die in der Galerie sichtbaren Ordner beschränken'}"
    Checked="GalleryViewFilter_Changed" Unchecked="GalleryViewFilter_Changed"/>
  <primitives:ToggleButton x:Name="InvertFilterToggle" Margin="3,0,8,0"
    Style="{StaticResource PcasaSearchInvertStyle}" Content="{loc:Tr Key='NOT'}"
    ToolTip="{loc:Tr Key='Treffer im gewählten Suchbereich umkehren'}"
    Checked="FilterResultsInversion_Changed" Unchecked="FilterResultsInversion_Changed"/>
  <Grid Width="180" Height="27" Margin="1,0,0,0" VerticalAlignment="Center">
   <TextBox x:Name="TagSearchBox" VerticalContentAlignment="Center" FontSize="12"
            Padding="29,0,27,0" ToolTip="{loc:Tr Key='Tags oder Dateinamen suchen'}"
            TextChanged="TagSearchBox_TextChanged">
    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
     <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=InvertFilterToggle}" Value="True">
      <Setter Property="TextDecorations" Value="Strikethrough"/>
     </DataTrigger></Style.Triggers>
    </Style></TextBox.Style>
   </TextBox>
   <ContentControl Template="{StaticResource PcasaSearchMagnifierTemplate}" Width="17" Height="17"
    Margin="7,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
   <Button x:Name="ClearTagSearchButton" HorizontalAlignment="Right" VerticalAlignment="Center"
      Margin="0,0,2,0" Style="{StaticResource PcasaSearchClearButtonStyle}"
      ToolTip="{loc:Tr Key='Suchfilter löschen'}" Visibility="Collapsed" Click="ClearTagSearch_Click"/>
  </Grid>
 </StackPanel>
</Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="1" Visibility="{Binding Visibility, ElementName=ViewerToolbar}"
                Background="{DynamicResource PcasaPanelBrush}"
                BorderBrush="{DynamicResource PcasaDividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid x:Name="BrowseToolbar" Visibility="Collapsed" Height="0" />

                <!-- Replaces the entire browsing toolbar in picture view. -->
                <Grid x:Name="ViewerToolbar" Visibility="Collapsed" Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{loc:Tr Key='← Zur Galerie'}"
                            Padding="12,4" Height="30" Margin="0,0,12,0"
                            Click="PhotoViewerBack_Click" />

                    <StackPanel x:Name="ViewerNavigationToolbar" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="‹" Width="36" Height="30"
                                ToolTip="{loc:Tr Key='Vorheriges Bild'}"
                                Click="PhotoViewerPrev_Click" />
                        <Button Content="›" Width="36" Height="30"
                                Margin="4,0,0,0" ToolTip="{loc:Tr Key='Nächstes Bild'}"
                                Click="PhotoViewerNext_Click" />
                    </StackPanel>

                    <StackPanel x:Name="ViewerComparisonToolbar" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="A" Width="36" Height="30" ToolTip="{loc:Tr Key='Einzelbild'}" Click="ViewerSingle_Click" />
                        <Button Style="{StaticResource PcasaStatusButtonStyle}" Content="A/A" Width="42" Height="30" Margin="5,0,0,0" ToolTip="{loc:Tr Key='Bild doppelt anzeigen'}" Click="ViewerAa_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ViewerToolbarImageTitle"
                               Grid.Column="2" Margin="16,0,12,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PcasaMutedTextBrush}" />

                    <StackPanel x:Name="PhotoZoomToolbar" Grid.Column="3"
                                Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Button Content="Fit to Screen" MinWidth="103" Height="30"
                                Margin="0,0,6,0" Click="PhotoViewerFit_Click" />
                        <Button Content="100 %" MinWidth="58" Height="30"
                                Margin="0,0,12,0" Click="PhotoViewerActualSize_Click" />
                        <TextBlock Text="{loc:Tr Key='Zoom'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="PhotoZoomSlider" Width="175"
                                Minimum="0" Maximum="100" Value="50"
                                SmallChange="0.5" LargeChange="5"
                                IsMoveToPointEnabled="True"
                                ValueChanged="PhotoViewerZoom_ValueChanged"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="PhotoZoomLabel" Text="Fit"
                                   MinWidth="73" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="BrowseWorkspaceGrid" Grid.Row="2" SizeChanged="BrowseWorkspace_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderSidebarColumn" Width="0.22*" MinWidth="170" />
                <ColumnDefinition x:Name="FolderSidebarDividerColumn" Width="5" />
                <ColumnDefinition x:Name="GalleryWorkspaceColumn" Width="0.78*" MinWidth="240" />
                <ColumnDefinition x:Name="InfoSidebarDividerColumn" Width="0" />
                <ColumnDefinition x:Name="InfoSidebarColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="FolderSidebarPanel" Grid.Column="0" Background="{DynamicResource PcasaPanelBrush}">
                <Grid>
                    <Grid x:Name="FolderTreePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Key='Ordner'}" FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="FolderImageTotalText" Text="(0)"
                                       FontSize="14" Margin="6,1,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,7,0">
                            <Button x:Name="FolderExpandAllButton" Style="{StaticResource PcasaFolderIconButtonStyle}" ToolTip="{loc:Tr Key='Alle Ordner aufklappen'}" Click="FolderExpandAll_Click">
                                <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="7" Canvas.Top="1" Width="9" Height="6" RadiusX="1.1" RadiusY="1.1" Fill="#36ADFF"/>
                                    <Path Data="M 11.5,7 L 11.5,21 M 11.5,13 L 15,13 M 11.5,20 L 15,20" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" />
                                    <Rectangle Canvas.Left="16" Canvas.Top="10" Width="7" Height="6" RadiusX="1" RadiusY="1" Fill="#C4CCD7"/>
                                    <Rectangle Canvas.Left="16" Canvas.Top="17" Width="7" Height="6" RadiusX="1" RadiusY="1" Fill="#C4CCD7"/>
                                </Canvas></Viewbox>
                            </Button>
                            <Button x:Name="FolderCollapseAllButton" Style="{StaticResource PcasaFolderIconButtonStyle}" ToolTip="{loc:Tr Key='Alle Ordner zuklappen'}" Click="FolderCollapseAll_Click">
                                <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="7" Canvas.Top="1" Width="9" Height="6" RadiusX="1.1" RadiusY="1.1" Fill="#36ADFF"/>
                                    <Path Data="M 11.5,7 L 11.5,21 M 11.5,13 L 15,13 M 11.5,20 L 15,20" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                                    <Rectangle Canvas.Left="16" Canvas.Top="10" Width="7" Height="6" RadiusX="1" RadiusY="1" Fill="#C4CCD7"/>
                                    <Rectangle Canvas.Left="16" Canvas.Top="17" Width="7" Height="6" RadiusX="1" RadiusY="1" Fill="#C4CCD7"/>
                                    <!-- Clear red X across BOTH child folders: unmistakable
                                         "collapse all", not a small decorative close icon. -->
                                    <Path Data="M 15,10 L 23,23 M 23,10 L 15,23"
                                          Stroke="#E43642" StrokeThickness="3.5"
                                          StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                    <Path Data="M 15,10 L 23,23 M 23,10 L 15,23"
                                          Stroke="#FFFFFF" StrokeThickness="0.6"
                                          StrokeStartLineCap="Round"/>
                                </Canvas></Viewbox>
                            </Button>
                            <Button x:Name="FolderTreeToggleButton" Style="{StaticResource PcasaFolderIconButtonStyle}" ToolTip="{loc:Tr Key='Expand / Compress'}" Click="FolderTreeToggle_Click">
                                <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24">
                                    <Path Data="M 12,2 L 12,5 M 12,9 L 12,12 M 12,16 L 12,19 M 12,22 L 12,23" Stroke="#36ADFF" StrokeThickness="1.5" />
                                    <Path Data="M 9,12 L 2,12 M 5,8 L 1,12 L 5,16" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.9" Fill="Transparent"/>
                                    <Path Data="M 15,12 L 22,12 M 19,8 L 23,12 L 19,16" Stroke="#36ADFF" StrokeThickness="1.9" Fill="Transparent"/>
                                </Canvas></Viewbox>
                            </Button>
                            <Button x:Name="ShowAllFilesystemFoldersButton" Style="{StaticResource PcasaFolderIconButtonStyle}" ToolTip="{loc:Tr Key='Explorer Ansicht'}" Click="ShowAllFilesystemFolders_Click">
                                <!-- Simple Explorer folder, without extra tray/symbol. -->
                                <Viewbox Width="23" Height="23"><Canvas Width="24" Height="24">
                                    <Path Data="M 1,5 Q 1,3 3,3 L 9,3 L 11,5 L 21,5 Q 23,5 23,7 L 23,20 Q 23,22 21,22 L 3,22 Q 1,22 1,20 Z" Fill="#D99A17"/>
                                    <Path Data="M 1,9 L 23,9 L 23,20 Q 23,22 21,22 L 3,22 Q 1,22 1,20 Z" Fill="#FFCE37"/>
                                </Canvas></Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TreeView x:Name="FoldersTree"
                              Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              ClipToBounds="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Margin="7,0,7,8"
                              Padding="0,0,12,0"
                              PreviewMouseRightButtonDown="FoldersTree_PreviewMouseRightButtonDown"
                              SelectedItemChanged="BrowseFoldersTree_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="FoldersTree_PreviewMouseLeftButtonDown"
                              AllowDrop="True"
                              PreviewDragOver="FolderTreeFiles_DragOver"
                              PreviewDragLeave="DragTarget_Leave"
                              PreviewDrop="FolderTreeFiles_Drop"
                              TreeViewItem.Expanded="FoldersTree_ExpansionChanged"
                              TreeViewItem.Collapsed="FoldersTree_ExpansionChanged">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Tr Key='Aktuellen Ordner einlesen / aktualisieren'}"
                                          Click="BrowseScanCurrentFolder_Click" />
                                <MenuItem Header="{loc:Tr Key='Ordnerinformationen'}"
                                          Click="FolderContext_Info_Click" />
                                <MenuItem Header="{loc:Tr Key='Aus PCasa entfernen'}"
                                          Click="FolderContext_Exclude_Click" />
                                <Separator />
                                <MenuItem Header="{loc:Tr Key='Neuen Unterordner anlegen …'}"
                                          Click="FolderContext_CreateDirectory_Click"/>
                                <MenuItem Header="{loc:Tr Key='In Windows Explorer öffnen'}"
                                          Click="FolderContext_OpenExplorer_Click" />
                                <MenuItem Header="{loc:Tr Key='Ordner auf Datenträger löschen …'}"
                                          Click="FolderContext_DeletePhysicalDirectory_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
                <Grid x:Name="ViewerEditingPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Navigation belongs at the upper-right, not inside a scrolling tool. -->
                    <DockPanel Grid.Row="0" Margin="10,6,9,7">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="34" Height="29" Content="‹"
                                    ToolTip="{loc:Tr Key='Vorheriges Bild'}" Margin="0,0,4,0"
                                    Click="PhotoViewerPrev_Click"/>
                            <Button Width="34" Height="29" Content="›"
                                    ToolTip="{loc:Tr Key='Nächstes Bild'}"
                                    Click="PhotoViewerNext_Click"/>
                        </StackPanel>
                        <TextBlock Text="{loc:Tr Key='Bearbeiten'}" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="9,6,9,5">
                            <WrapPanel x:Name="ViewerToolsOverview" HorizontalAlignment="Left">
                                <WrapPanel x:Name="ViewerToolsList"/>
                            </WrapPanel>
                            <StackPanel x:Name="ViewerCropOptions" Visibility="Collapsed" Margin="2,0,2,0">
                                <DockPanel Margin="0,0,0,9">
                                    <Button x:Name="CropBackButton" Content="‹" Width="26" Height="26"
                                            DockPanel.Dock="Left" Margin="0,0,6,0" ToolTip="{loc:Tr Key='Zurück'}"/>
                                    <TextBlock Text="{loc:Tr Key='Zuschneiden'}" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{loc:Tr Key='Seitenverhältnis'}" FontSize="11"
                                           Foreground="{DynamicResource PcasaMutedTextBrush}" Margin="0,0,0,2"/>
                                <WrapPanel x:Name="CropAspectButtons"/>
                                <TextBlock Text="{loc:Tr Key='Ausrichtung'}" FontSize="11" Margin="0,9,0,3"
                                           Foreground="{DynamicResource PcasaMutedTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="CropHorizontalButton" Width="49" Height="33"
                                            Margin="0,0,6,0" ToolTip="{loc:Tr Key='Querformat'}">
                                        <Rectangle Width="27" Height="17" Stroke="#374151"
                                                   StrokeThickness="1.6" Fill="Transparent"/>
                                    </Button>
                                    <Button x:Name="CropVerticalButton" Width="49" Height="33"
                                            ToolTip="{loc:Tr Key='Hochformat'}">
                                        <Rectangle Width="17" Height="27" Stroke="#374151"
                                                   StrokeThickness="1.6" Fill="Transparent"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <Button x:Name="CropUndoButton" Width="37" Height="29" Content="↶"
                                            FontSize="18" Margin="0,0,5,0"
                                            ToolTip="{loc:Tr Key='Rückgängig machen'}"/>
                                    <Button x:Name="CropRedoButton" Width="37" Height="29" Content="↷"
                                            FontSize="18" ToolTip="{loc:Tr Key='Wiederholen'}"/>
                                </StackPanel>
                                <Button x:Name="CropPreviewButton" Height="29" Padding="12,3"
                                        Content="{loc:Tr Key='Vorschau · Original gedrückt halten'}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Border Grid.Row="2" Padding="9,7" BorderThickness="0,1,0,1"
                            BorderBrush="{DynamicResource PcasaDividerBrush}">
                        <StackPanel>
                            <TextBlock Text="Histogramm &amp; Kamera-Informationen" FontSize="12"
                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Canvas x:Name="ViewerHistogramCanvas" Height="74" ClipToBounds="True"
                                    Background="{DynamicResource PcasaPanelBrush}"/>
                            <TextBlock x:Name="ViewerCameraDetails" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="ViewerCropFooter" Grid.Row="3" Visibility="Collapsed"
