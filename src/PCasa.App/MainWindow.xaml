<Window x:Class="PCasa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PCasa.App.Controls"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="PCasa"
        Width="1500"
        Height="920"
        MinWidth="1000"
        MinHeight="650"
        Background="{DynamicResource PcasaWindowBrush}"
        Foreground="{DynamicResource PcasaTextBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="BackgroundScan_WindowLoaded"
        Closed="BackgroundScan_WindowClosed"
        PreviewKeyDown="PhotoViewerWindow_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PcasaLogicSymbolStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26" Background="Transparent">
                            <Ellipse x:Name="Ring" Margin="2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#DD3D3D"/>
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Shared Picasa-like 29 px icon buttons; no separate interaction model. -->
        <Style x:Key="PcasaFooterIconButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PcasaStatusButtonStyle}">
            <Setter Property="Width" Value="29"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <!-- The two footer sliders use neutral Picasa-like rails and
             narrow rectangular knobs. No Windows accent blue and no circles. -->
        <ControlTemplate x:Key="PcasaCompactSliderThumbTemplate" TargetType="{x:Type primitives:Thumb}">
            <Border Width="13" Height="21" CornerRadius="3"
                    BorderBrush="#80858A" BorderThickness="1"
                    Background="#E1E2E3">
                <Border Margin="2" CornerRadius="2" BorderThickness="1,0,0,0"
                        BorderBrush="#FFFFFF" Background="#ECEDEE"/>
            </Border>
        </ControlTemplate>
        <Style x:Key="PcasaNeutralSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="26" Background="Transparent">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    BorderThickness="1" BorderBrush="#989DA2" Background="#C4C8CB"/>
                            <primitives:Track x:Name="PART_Track" VerticalAlignment="Center"
                                              IsDirectionReversed="False">
                                <primitives:Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  IsTabStop="False" Opacity="0"/>
                                </primitives:Track.DecreaseRepeatButton>
                                <primitives:Track.Thumb>
                                    <primitives:Thumb Width="13" Height="21"
                                        Template="{StaticResource PcasaCompactSliderThumbTemplate}" />
                                </primitives:Track.Thumb>
                                <primitives:Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  IsTabStop="False" Opacity="0"/>
                                </primitives:Track.IncreaseRepeatButton>
                            </primitives:Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PcasaTopBrush}"
                MinHeight="42">
            <DockPanel LastChildFill="True">


                <Grid DockPanel.Dock="Right" Width="195" Height="27" Margin="8,0,12,0">
                    <TextBox x:Name="TagSearchBox" VerticalContentAlignment="Center"
                             Padding="6,0,27,0" ToolTip="Tags oder Dateinamen suchen"
                             TextChanged="TagSearchBox_TextChanged" />
                    <Button x:Name="ClearTagSearchButton" Width="24" Height="24"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,2,0" Cursor="Hand"
                            ToolTip="Suchfilter löschen" Visibility="Collapsed"
                            Click="ClearTagSearch_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ClearBackground" Background="Transparent" CornerRadius="3">
                                    <TextBlock Text="✕" FontFamily="Segoe UI Symbol"
                                               FontSize="17" FontWeight="Bold"
                                               Foreground="#E34848"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ClearBackground" Property="Background"
                                                Value="{DynamicResource PcasaHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <RadioButton x:Name="SearchAllScope" GroupName="TagSearchScope" Style="{StaticResource PcasaLogicSymbolStyle}" IsChecked="True" Checked="TagSearchScope_Changed" ToolTip="Tags in der gesamten Bibliothek suchen">
                        <Grid Width="15" Height="15">
                            <Ellipse Width="15" Height="15" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.5"/>
                            <Path Data="M9,1.5 C4,5 4,13 9,16.5 M9,1.5 C14,5 14,13 9,16.5 M1.5,9 H16.5"
                                  Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.2"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="SearchTreeScope" GroupName="TagSearchScope" Style="{StaticResource PcasaLogicSymbolStyle}" Checked="TagSearchScope_Changed" ToolTip="Tags nur im ausgewählten Ordnerbaum suchen">
                        <Grid Width="15" Height="15" RenderTransformOrigin="0.5,0.5">
                            <Grid.LayoutTransform><ScaleTransform ScaleX="0.78" ScaleY="0.78"/></Grid.LayoutTransform>
                            <Path Data="M2,2 V16 M2,5 H7 M2,14 H7 M7,2.5 H11 L12,4 H17 V9 H7 Z M7,11.5 H11 L12,13 H17 V18 H7 Z"
                                  Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.35" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="SearchCurrentScope" GroupName="TagSearchScope"
                                 Style="{StaticResource PcasaLogicSymbolStyle}"
                                 Checked="TagSearchScope_Changed" ToolTip="Nur aktueller Ordner (ohne Unterordner)">
                        <Grid Width="16" Height="15">
                            <Path Data="M1,4 L5,4 L7,2 L15,2 L15,13 L1,13 Z"
                                  Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round" Fill="Transparent"/>
                            <Path Data="M4,8 L12,8" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.5"/>
                        </Grid>
                    </RadioButton>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <RadioButton x:Name="SearchTagsMode" GroupName="SearchMode"
                                 Style="{StaticResource PcasaLogicSymbolStyle}" IsChecked="True"
                                 Checked="SearchMode_Changed" ToolTip="Nach Tags filtern">
                        <TextBlock Text="T" FontWeight="SemiBold" FontSize="12"/>
                    </RadioButton>
                    <RadioButton x:Name="SearchFileNameMode" GroupName="SearchMode"
                                 Style="{StaticResource PcasaLogicSymbolStyle}"
                                 Checked="SearchMode_Changed" ToolTip="Nach Dateinamen filtern">
                        <TextBlock Text="F" FontWeight="SemiBold" FontSize="12"/>
                    </RadioButton>
                </StackPanel>
                <Menu Background="Transparent"
                      Foreground="{DynamicResource PcasaTextBrush}"
                      VerticalAlignment="Center"
                      Padding="0">
                    <Menu.Resources>
                        <!-- Local menu template only: no application-wide style changes. -->
                        <Style TargetType="{x:Type MenuItem}">
                            <Setter Property="Foreground" Value="{DynamicResource PcasaTextBrush}" />
                            <Setter Property="Background" Value="{DynamicResource PcasaPanelBrush}" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type MenuItem}">
                                        <Grid HorizontalAlignment="Left">
                                            <Border x:Name="ItemBackground" Background="Transparent">
                                                <Grid Height="28">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="MenuCheckColumn" Width="20"/>
                                                        <ColumnDefinition x:Name="MenuLabelColumn" Width="Auto"/>
                                                        <ColumnDefinition x:Name="MenuArrowColumn" Width="15"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="CheckMark" Grid.Column="0" Text="✓"
                                                               Visibility="Collapsed" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                    <ContentPresenter x:Name="MenuHeaderPresenter" Grid.Column="1" ContentSource="Header"
                                                                      RecognizesAccessKey="True" VerticalAlignment="Center"
                                                                      Margin="5,0,5,0"/>
                                                    <TextBlock x:Name="SubArrow" Grid.Column="2" Text="›"
                                                               Visibility="Collapsed" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Placement="Custom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                   Loaded="MenuPopup_Loaded" HorizontalOffset="0" VerticalOffset="0"
                                                   AllowsTransparency="True" Focusable="False"
                                                   PopupAnimation="None">
                                                <Border Background="{DynamicResource PcasaPanelBrush}"
                                                        BorderBrush="{DynamicResource PcasaDividerBrush}"
                                                        BorderThickness="1" Padding="1">
                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Role" Value="TopLevelHeader">
                                                <Setter TargetName="ItemBackground" Property="MinWidth" Value="0"/>
                                                <Setter TargetName="ItemBackground" Property="Padding" Value="0"/>
                                                <Setter TargetName="MenuHeaderPresenter" Property="Margin" Value="0"/>
                                                <Setter TargetName="MenuCheckColumn" Property="Width" Value="0"/>
                                                <Setter TargetName="MenuArrowColumn" Property="Width" Value="0"/>
                                            </Trigger>
                                            <Trigger Property="Role" Value="SubmenuHeader">
                                                <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource PcasaHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Menu.Resources>
                    <MenuItem Header="Datei" Margin="0,0,20,0" HorizontalAlignment="Left" />
                    <MenuItem Header="Bearbeiten" Margin="0,0,20,0" HorizontalAlignment="Left">
                        <MenuItem Header="Auswahl invertieren (aktueller Ordner)"
                                  InputGestureText="Strg+I" Click="GalleryInvertSelection_Click"/>
                    </MenuItem>
                    <MenuItem Header="Ordner" Margin="0,0,20,0" HorizontalAlignment="Left">
                        <MenuItem Header="Ordner-Manager..."
                                  Click="BrowseFolderManager_Click" />
                        <Separator />
                        <MenuItem x:Name="ScanAllMenuItem"
                                  Header="Alle überwachten Ordner einlesen"
                                  Click="BrowseScanAll_Click" />
                    </MenuItem>
                    <MenuItem Header="Optionen" Margin="0,0,20,0" HorizontalAlignment="Left">
                        <MenuItem Header="Scheduler-Monitor..." Click="SchedulerMonitor_Click" />
                        <Separator />
                        <MenuItem Header="Darstellung">
                            <MenuItem Header="Design">
                                <MenuItem x:Name="ThemeLightMenu" Header="Hell" IsCheckable="True" Click="AppearanceTheme_Click" Tag="Light" />
                                <MenuItem x:Name="ThemeDarkMenu" Header="Dunkel" IsCheckable="True" Click="AppearanceTheme_Click" Tag="Dark" />
                                <MenuItem x:Name="ThemeSystemMenu" Header="System" IsCheckable="True" Click="AppearanceTheme_Click" Tag="System" />
                            </MenuItem>
                            <MenuItem Header="Galeriehintergrund">
                                <MenuItem x:Name="GalleryBackgroundAutoMenu" Header="Standard (zum Design)" IsCheckable="True" Tag="Auto" Click="AppearanceBackground_Click" />
                                <Separator />
                                <MenuItem x:Name="GalleryBackgroundDarkMenu" Header="Einfarbig dunkel" IsCheckable="True" Tag="Dark" Click="AppearanceBackground_Click" />
                                <MenuItem x:Name="GalleryBackgroundLightMenu" Header="Einfarbig hell" IsCheckable="True" Tag="Light" Click="AppearanceBackground_Click" />
                                <MenuItem x:Name="GalleryBackgroundCanvasMenu" Header="Leinwand hell" IsCheckable="True" Tag="Canvas" Click="AppearanceBackground_Click" />
                                <MenuItem x:Name="GalleryBackgroundCanvasDarkMenu" Header="Leinwand dunkel" IsCheckable="True" Tag="CanvasDark" Click="AppearanceBackground_Click" />
                            </MenuItem>
                            <MenuItem x:Name="RestoreGalleryPositionMenu" Header="Galerieposition beim Start wiederherstellen" IsCheckable="True" Click="AppearanceRestorePosition_Click" />
                            <Separator />
                            <MenuItem Header="Ordnerstatus">
                                <MenuItem x:Name="FolderStatusAlwaysMenu" Header="Immer anzeigen" IsCheckable="True" Tag="Always" Click="FolderStatusMode_Click"/>
                                <MenuItem x:Name="FolderStatusProblemsMenu" Header="Nur Aktivität und Probleme" IsCheckable="True" Tag="Problems" Click="FolderStatusMode_Click"/>
                                <MenuItem x:Name="FolderStatusNeverMenu" Header="Nie anzeigen" IsCheckable="True" Tag="None" Click="FolderStatusMode_Click"/>
                            </MenuItem>
                            <MenuItem Header="Eingeklappte Ordner in Galerie ausblenden" x:Name="HideCollapsedFoldersMenu" IsCheckable="True" Click="HideCollapsedFolders_Click" />
                            <MenuItem Header="Dateinamen unter Thumbnails" x:Name="ThumbnailFileNamesMenu"
                                      IsCheckable="True" IsChecked="True" Click="AppearanceThumbnailOptions_Click"/>
                            <MenuItem Header="GPS-, Tag- und RAW-Symbole" x:Name="ThumbnailIconsMenu"
                                      IsCheckable="True" IsChecked="True" Click="AppearanceThumbnailOptions_Click"/>
                            <MenuItem Header="Ordnerstatus-Legende" Click="FolderStatusLegend_Click" />
                            <MenuItem Header="Thumbnail-Schatten" IsCheckable="True" IsChecked="False" Loaded="BrowseThumbnailShadowMenu_Loaded" Click="BrowseThumbnailShadowMenu_Click" x:Name="ThumbnailShadowMenuItem" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Hilfe" Margin="0,0,20,0" HorizontalAlignment="Left" />
                </Menu>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Visibility="{Binding Visibility, ElementName=ViewerToolbar}"
                Background="{DynamicResource PcasaPanelBrush}"
                BorderBrush="{DynamicResource PcasaDividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid x:Name="BrowseToolbar" Visibility="Collapsed" Height="0" />

                <!-- Replaces the entire browsing toolbar in picture view. -->
                <Grid x:Name="ViewerToolbar" Visibility="Collapsed" Margin="14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="← Zur Galerie"
                            Padding="12,4" Height="30" Margin="0,0,12,0"
                            Click="PhotoViewerBack_Click" />

                    <StackPanel x:Name="ViewerNavigationToolbar" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="‹" Width="36" Height="30"
                                ToolTip="Vorheriges Bild"
                                Click="PhotoViewerPrev_Click" />
                        <Button Content="›" Width="36" Height="30"
                                Margin="4,0,0,0" ToolTip="Nächstes Bild"
                                Click="PhotoViewerNext_Click" />
                    </StackPanel>

                    <StackPanel x:Name="ViewerComparisonToolbar" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="A" Width="36" Height="30" ToolTip="Einzelbild" Click="ViewerSingle_Click" />
                        <Button Style="{StaticResource PcasaStatusButtonStyle}" Content="A/A" Width="42" Height="30" Margin="5,0,0,0" ToolTip="Bild doppelt anzeigen" Click="ViewerAa_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ViewerToolbarImageTitle"
                               Grid.Column="2" Margin="16,0,12,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource PcasaMutedTextBrush}" />

                    <StackPanel x:Name="PhotoZoomToolbar" Grid.Column="3"
                                Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Button Content="Fit to Screen" MinWidth="103" Height="30"
                                Margin="0,0,6,0" Click="PhotoViewerFit_Click" />
                        <Button Content="100 %" MinWidth="58" Height="30"
                                Margin="0,0,12,0" Click="PhotoViewerActualSize_Click" />
                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="PhotoZoomSlider" Width="175"
                                Minimum="0" Maximum="100" Value="50"
                                SmallChange="0.5" LargeChange="5"
                                IsMoveToPointEnabled="True"
                                ValueChanged="PhotoViewerZoom_ValueChanged"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="PhotoZoomLabel" Text="Fit"
                                   MinWidth="73" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" MinWidth="170" MaxWidth="800" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <!-- Reserved for optional info/GPS/tools panel, initially hidden. -->
                <ColumnDefinition x:Name="InfoSidebarDividerColumn" Width="0" />
                <ColumnDefinition x:Name="InfoSidebarColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PcasaPanelBrush}">
                <Grid>
                    <Grid x:Name="FolderTreePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ordner"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,7,0">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource PcasaStatusButtonStyle}"/>
                            </StackPanel.Resources>
                            <Button x:Name="FolderExpandAllButton" Content="Alle auf" Padding="6,2" Margin="0,0,4,0" Click="FolderExpandAll_Click" />
                            <Button x:Name="FolderCollapseAllButton" Content="Alle zu" Padding="6,2" Margin="0,0,4,0" Click="FolderCollapseAll_Click" />
                            <Button x:Name="FolderTreeToggleButton"
                                    Content="Compress" Padding="9,2"
                                    ToolTip="Pfadansicht verkürzen oder vollständig zeigen"
                                    Click="FolderTreeToggle_Click" />
                        </StackPanel>
                    </Grid>
                    <TreeView x:Name="FoldersTree"
                              Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              ClipToBounds="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Margin="7,0,7,8"
                              Padding="0,0,12,0"
                              PreviewMouseRightButtonDown="FoldersTree_PreviewMouseRightButtonDown"
                              SelectedItemChanged="BrowseFoldersTree_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="FoldersTree_PreviewMouseLeftButtonDown"
                              AllowDrop="True"
                              PreviewDragOver="FolderTreeFiles_DragOver"
                              PreviewDragLeave="DragTarget_Leave"
                              PreviewDrop="FolderTreeFiles_Drop"
                              TreeViewItem.Expanded="FoldersTree_ExpansionChanged"
                              TreeViewItem.Collapsed="FoldersTree_ExpansionChanged">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Aktuellen Ordner einlesen / aktualisieren"
                                          Click="BrowseScanCurrentFolder_Click" />
                                <MenuItem Header="Neuen Unterordner anlegen …" Click="FolderContext_CreateDirectory_Click"/>
                                <Separator />
                                <MenuItem Header="In Windows Explorer öffnen"
                                          Click="FolderContext_OpenExplorer_Click" />
                                <MenuItem Header="Ordnerinformationen"
                                          Click="FolderContext_Info_Click" />
                                <Separator />
                                <MenuItem Header="Aus PCasa entfernen"
                                          Click="FolderContext_Exclude_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
                <Grid x:Name="ViewerEditingPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Bearbeiten" FontSize="16" FontWeight="SemiBold"
                               Margin="16,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Margin="16,12,16,0">
                        <TextBlock Text="Bildbearbeitung"
                                   FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Hier erscheinen die Bearbeitungswerkzeuge."
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{DynamicResource PcasaMutedTextBrush}" />
                    </StackPanel>
                </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Background="{DynamicResource PcasaDividerBrush}"
                          Cursor="SizeWE" />

            <Grid Grid.Column="2" Background="{DynamicResource PcasaWindowBrush}">
                <Grid SizeChanged="BrowseGalleryViewport_SizeChanged">
                    <ScrollViewer x:Name="BrowseScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly"
                                  PreviewMouseWheel="BrowseScrollViewer_PreviewMouseWheel"
                                  ScrollChanged="BrowseScrollViewer_ScrollChanged">
                        <controls:BrowseGallerySurface x:Name="BrowseSurface"
                                                       Loaded="BrowseSurface_Loaded"
                                                       AllowDrop="True"
                                                       DragOver="GalleryFiles_DragOver"
                                                       DragLeave="DragTarget_Leave"
                                                       Drop="GalleryFiles_Drop"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Top" />
                    </ScrollViewer>

                    <Grid x:Name="PhotoViewerPanel"
                          Visibility="Collapsed"
                          Background="#1D1E20"
                          Focusable="True"
                          PreviewKeyDown="PhotoViewerPanel_PreviewKeyDown"
                          IsManipulationEnabled="True"
                          ManipulationStarting="PhotoViewer_ManipulationStarting"
                          ManipulationDelta="PhotoViewer_ManipulationDelta"
                          ManipulationCompleted="PhotoViewer_ManipulationCompleted"
                          PreviewMouseLeftButtonDown="PhotoViewerPanel_MouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="PhotoViewerPan_MouseLeftButtonUp"
                          PreviewMouseMove="PhotoViewerPan_MouseMove"
                          MouseRightButtonDown="PhotoViewerPanel_MouseRightButtonDown">
                        <ScrollViewer x:Name="PhotoViewerScroller"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="False"
                                      Background="Transparent"
                                      SizeChanged="PhotoViewerViewport_SizeChanged"
                                      ScrollChanged="PhotoViewerScroller_ScrollChanged">
                            <Grid x:Name="PhotoViewerCanvas"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Background="Transparent">
                                <Image x:Name="PhotoViewerImage"
                                       Stretch="Fill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </ScrollViewer>
                        <Grid x:Name="ComparisonPanel" Visibility="Collapsed" Background="#1D1E20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="ComparisonImageA" Grid.Column="0" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border Grid.Column="1" Background="#444444"/>
                            <Image x:Name="ComparisonImageB" Grid.Column="2" Stretch="Uniform" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <controls:PhotoZoomNavigator x:Name="PhotoViewerNavigator" />
                        <Border x:Name="PhotoViewerQualityBanner"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="14"
                                Padding="9,5"
                                Background="#D9262729"
                                CornerRadius="3"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="PhotoViewerQualityText"
                                       Foreground="#E6E6E6"
                                       FontSize="12" />
                        </Border>
                    </Grid>

                    <StackPanel x:Name="EmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="EmptyPanelHeading" Text="Noch keine Bilder im Katalog"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyPanelDescription" Text="Ordner im Menü einlesen, um die Galerie zu füllen."
                                   Foreground="{DynamicResource PcasaMutedTextBrush}"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="BrowseCachePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="24,18"
                            Background="#E6252628"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <StackPanel Width="440">
                            <TextBlock Text="Vorschaudaten werden vorbereitet"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="BrowseCacheProgressText"
                                       Margin="0,8,0,10"
                                       Foreground="{DynamicResource PcasaMutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       Text="0 / 0" />
                            <ProgressBar x:Name="BrowseCacheProgressBar"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="InfoSidebarDivider" Grid.Column="3"
                    Visibility="Collapsed"
                    Background="{DynamicResource PcasaDividerBrush}" />

            <Border x:Name="InfoSidebarPanel" Grid.Column="4"
                    Visibility="Collapsed"
                    Background="{DynamicResource PcasaPanelBrush}">
                <Grid Margin="10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,0,0,12">
                        <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                                HorizontalAlignment="Right" ToolTip="Seitenleiste schließen"
                                Style="{StaticResource PcasaStatusButtonStyle}" Click="CloseSidebar_Click"/>
                        <TextBlock x:Name="SidePanelHeading" Text="Bildinformationen" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer x:Name="GeneralSidebarScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="SidePanelText" TextWrapping="Wrap" FontSize="12"/>
                    </ScrollViewer>
                    <Grid x:Name="TagSidebar" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Tag hinzufügen" FontSize="12" Margin="3,0,0,5"/>
                        <DockPanel Grid.Row="1" Margin="2,0,2,10">
                            <Button DockPanel.Dock="Right" Content="+" Width="30" Height="27"
                                    Style="{StaticResource PcasaStatusButtonStyle}" ToolTip="Tag zu ausgewählten Bildern hinzufügen"
                                    Click="TagAdd_Click"/>
                            <TextBox x:Name="TagEntryBox" Margin="0,0,4,0"
                                     VerticalContentAlignment="Center" ToolTip="Neues Tag eingeben" KeyDown="TagEntry_KeyDown"/>
                        </DockPanel>
                        <DockPanel Grid.Row="2" Margin="2,0,2,7">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <RadioButton x:Name="TagLogicOr" GroupName="TagListLogic" Style="{StaticResource PcasaLogicSymbolStyle}" IsChecked="True"
                                             Checked="TagLogic_Changed" ToolTip="ODER: alle Tags der ausgewählten Bilder">
                                    <TextBlock Text="∨" FontFamily="Cambria Math" FontSize="16" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </RadioButton>
                                <RadioButton x:Name="TagLogicAnd" GroupName="TagListLogic" Style="{StaticResource PcasaLogicSymbolStyle}"
                                             Checked="TagLogic_Changed" ToolTip="UND: nur Tags, die alle ausgewählten Bilder gemeinsam haben">
                                    <TextBlock Text="∧" FontFamily="Cambria Math" FontSize="16" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </RadioButton>
                            </StackPanel>
                            <TextBlock x:Name="TagSelectionCaption" Text="Tags der Auswahl" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <Border Grid.Row="3" BorderBrush="{DynamicResource PcasaDividerBrush}" BorderThickness="1"
                                Background="{DynamicResource PcasaPanelAltBrush}" CornerRadius="7" Padding="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="TagRowsPanel"/>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Grid.Row="4" Margin="2,7,2,0" MinHeight="96">
                            <TextBlock Text="Schnell-Tags" FontSize="12" Margin="0,0,0,5"/>
                            <WrapPanel x:Name="TagQuickPanel"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="{DynamicResource PcasaPanelBrush}"
                BorderBrush="{DynamicResource PcasaDividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           MouseLeftButtonUp="BrowseStatus_Click"
                           Cursor="Hand" ToolTip="Laufenden Fortschritt anzeigen"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PcasaMutedTextBrush}"
                           Text="0 Bilder" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="ThumbnailSizeToolbar" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,11,0">
                        <Viewbox Width="23" Height="23" Margin="0,0,4,0" ToolTip="Thumbnailgröße">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" RadiusX="1"
                                           Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.5"/>
                                <Path Data="M 11,11 L 6,6 M 6,10 L 6,6 L 10,6 M 13,13 L 18,18 M 18,14 L 18,18 L 14,18"
                                      Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <Slider x:Name="ThumbnailSizeSlider" Style="{StaticResource PcasaNeutralSliderStyle}" Width="120" Minimum="72" Maximum="600"
                                Value="190" Loaded="CompactThumbnailSlider_Loaded"
                                ValueChanged="BrowseThumbnailSizeSlider_ValueChanged"
                                VerticalAlignment="Center" ToolTip="Thumbnailgröße" />
                    </StackPanel>
                    <StackPanel x:Name="ThumbnailSpacingToolbar" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Viewbox Width="30" Height="23" Margin="0,0,4,0" ToolTip="Thumbnailabstand">
                            <Canvas Width="34" Height="24">
                                <Rectangle Canvas.Left="1.5" Canvas.Top="5" Width="9" Height="14"
                                           Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.5"/>
                                <Rectangle Canvas.Left="23.5" Canvas.Top="5" Width="9" Height="14"
                                           Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.5"/>
                                <Path Data="M 13,12 L 21,12 M 16,9 L 13,12 L 16,15 M 18,9 L 21,12 L 18,15"
                                      Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <Slider x:Name="ThumbnailSpacingSlider" Style="{StaticResource PcasaNeutralSliderStyle}" Width="112" Minimum="0" Maximum="160" Value="10"
                                Loaded="CompactThumbnailSlider_Loaded"
                                ValueChanged="ThumbnailSpacingSlider_ValueChanged"
                                VerticalAlignment="Center" ToolTip="Thumbnailabstand" />
                    </StackPanel>
                    <Button Style="{StaticResource PcasaStatusButtonStyle}" Content="A/B" Width="38" Height="25"
                            Margin="0,0,10,0" ToolTip="Zwei ausgewählte Bilder vergleichen"
                            x:Name="CompareAbButton" Click="CompareAb_Click" IsEnabled="False" />
                    <Button x:Name="TagSidebarButton" Style="{StaticResource PcasaFooterIconButtonStyle}"
                            ToolTip="Tags anzeigen" Tag="Tags" Click="SidebarMode_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 2,3 L 12,3 L 22,13 L 13,22 L 2,11 Z"
                                      Fill="#4D9EDB" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="1"/>
                                <Ellipse Canvas.Left="5" Canvas.Top="6" Width="3.2" Height="3.2"
                                         Fill="{DynamicResource PcasaPanelBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="GpsSidebarButton" Style="{StaticResource PcasaFooterIconButtonStyle}"
                            ToolTip="GPS-Informationen anzeigen" Tag="GPS" Click="SidebarMode_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 12,1 C 6.5,1 3,5 3,10 C 3,16 12,23 12,23 C 12,23 21,16 21,10 C 21,5 17.5,1 12,1 Z"
                                      Fill="#DF4A54" Stroke="{DynamicResource PcasaTextBrush}" StrokeThickness="0.8"/>
                                <Ellipse Canvas.Left="8.6" Canvas.Top="6.6" Width="6.8" Height="6.8"
                                         Fill="{DynamicResource PcasaPanelBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="InfoSidebarButton" Style="{StaticResource PcasaFooterIconButtonStyle}"
                            Margin="0,0,11,0" ToolTip="Bildinformationen anzeigen" Tag="Info" Click="SidebarMode_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                                         Fill="{DynamicResource PcasaAccentBrush}"/>
                                <Ellipse Canvas.Left="10.8" Canvas.Top="6" Width="2.4" Height="2.4" Fill="White"/>
                                <Rectangle Canvas.Left="11" Canvas.Top="10" Width="2" Height="8" Fill="White"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <TextBlock x:Name="SelectionText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PcasaMutedTextBrush}"
                           Text="Auswahl: 0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
