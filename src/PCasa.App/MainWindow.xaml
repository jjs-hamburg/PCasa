  </ToggleButton></StackPanel>
<TextBlock Grid.Row="5" Text="{loc:Tr Key='Ansicht'}" FontSize="10" Margin="2,0,0,2" Foreground="{DynamicResource PcasaMutedTextBrush}"/>
